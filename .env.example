# 정보화 설계 도우미 — 환경설정 예시. 이 파일을 .env로 복사해 값을 채운다(.env는 Git에 올리지 않음).

# 실행 환경: production(기본, 인증 필수) | development(로컬 개발)
APP_ENV=production
# 데이터 저장 위치(SQLite DB·업로드 원본·사용자 정의 기준). 보통은 주석 그대로 둔다:
#   Docker 이미지는 /data(볼륨), 소스 실행은 backend/data. 여기서 값을 넣으면 Docker에서도 그 경로를 써서 볼륨 밖에 저장될 수 있다.
# DATA_DIR=./data

# 세션 서명 키(32자 이상 무작위). 생성: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# 관리자 비밀번호 해시(권장). 생성: cd backend && uv run python -m app.auth hash
ADMIN_PASSWORD_HASH=
# 또는 평문 비밀번호(10자 이상, 해시를 쓰면 비워 둠)
ADMIN_PASSWORD=
# HTTPS 뒤에서 운영하면 true
COOKIE_SECURE=false
# 로컬 개발에서만 인증 생략 가능(APP_ENV=development일 때만 허용)
AUTH_DISABLED=false

# ─── AI 연결 ───────────────────────────────────────────────
# 여러 AI를 동시에 설정할 수 있다. 키(또는 주소)를 넣은 연결만 켜지고, 프로젝트마다 '개요'에서 골라 쓴다.
# AI_PROVIDER = 서버 기본 연결: openai | anthropic | compatible | sample
#   비워 두면 OPENAI_API_KEY가 있을 때 openai, 없으면 sample(규칙 기반, AI 아님).
# 외부 AI로 보내기 전에는 요청마다 전송 범위를 보여 주고 동의를 받는다.
AI_PROVIDER=

# OpenAI(ChatGPT) — 기본
OPENAI_API_KEY=
# 계정에서 쓸 수 있는 모델명(필수). 2026-10-30 비교시험(docs/AI_COST.md)을 통과한 구성:
#   OPENAI_MODEL=gpt-6-luna + OPENAI_MODEL_FP_CANDIDATES=gpt-6.1-sol
OPENAI_MODEL=
# 작업별 모델(선택): OPENAI_MODEL_QUESTIONS / _REQUIREMENTS / _DESIGN / _FP_CANDIDATES / _DOC_EXTRACT
#   비우면 OPENAI_MODEL. 작업 제출 때의 모델이 그 작업에 고정된다(대기·재시도 중 바뀌지 않음).
OPENAI_MODEL_FP_CANDIDATES=
# 추론 강도(선택, 지원 모델만): none|minimal|low|medium|high|xhigh. 비우면 모델 기본값(검증한 값)
# OPENAI_REASONING_EFFORT=
# 프록시·Azure OpenAI(v1 호환 주소) 등을 쓸 때만
# OPENAI_BASE_URL=

# Anthropic(Claude) — 선택
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=

# OpenAI 호환 API를 제공하는 상용·사내 LLM — 선택(vLLM, Ollama, LM Studio, 국내 LLM 등)
# 예: http://10.0.0.5:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 화면에 보일 이름(띄어쓰기 없이, 예: 사내LLM). 비우면 'OpenAI 호환 LLM'
LLM_LABEL=
# json_schema(구조화 출력 지원) | json_object | prompt(지원 안 함)
LLM_JSON_MODE=json_schema
# 기관 내부 설치형이면 false(전송 동의 생략)
LLM_EXTERNAL=true
# 사내 LLM도 작업별 모델·추론 강도 가능: LLM_MODEL_<작업>, LLM_REASONING_EFFORT

AI_TIMEOUT_SEC=600
AI_MAX_OUTPUT_TOKENS=32000

# 업로드 제한
MAX_UPLOAD_MB=30
MAX_UNCOMPRESSED_MB=200

# 서버가 조회할 수 있는 공식 자료 도메인(쉼표 구분). 비우면 기본 목록 사용.
# OFFICIAL_SOURCE_ALLOWLIST=www.sw.or.kr,www.postgresql.org,tomcat.apache.org
