{
  "name": "sw-design-helper-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "demo:data": "cd ../backend && uv run python -m tools.demo_data && uv run python -m tools.demo_data --check"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
